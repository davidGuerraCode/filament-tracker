# Copy to .env (and .env.local for a future frontend) and fill in real values.
# Never commit the filled-in file.

# Project URL and anon key: Supabase Dashboard > Project Settings > API.
# Safe to expose to a browser client -- RLS is what actually restricts access.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key: Supabase Dashboard > Project Settings > API.
# Bypasses RLS entirely -- server/Edge Function use only, never ship this to
# a browser. The Edge Function does NOT need this set manually: Supabase
# injects it automatically as a runtime secret for every deployed function.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (https://aistudio.google.com/apikey) -- free tier, no card
# required. Set as an Edge Function secret with `supabase secrets set
# GEMINI_API_KEY=...`, not here (see supabase/README.md). Listed here only so
# every required credential is documented in one place.
GEMINI_API_KEY=
